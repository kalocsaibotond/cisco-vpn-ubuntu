#cloud-config

autoinstall:
  version: 1

  source:
    search_drivers: true
    id: ubuntu-server-minimal

  storage:
    config:
      - type: disk
        id: ubuntu-disk
        path: /dev/vdc
        wipe: superblock-recursive

      - type: format
        id: root-format
        volume: ubuntu-disk
        fstype: ext4

      - type: mount
        device: root-format
        path: /

  drivers:
    install: true

  shutdown: poweroff

  identity:
    realname: "VPN user"
    username: vpnuser
    password: "$1$V0/SeOln$5KjvZfqIzL.w1HMehRUN6." # The password is vpnuser .
    hostname: ubuntu-pc

  keyboard:
    layout: hu

  timezone: "Europe/Budapest"

  network:
    version: 2
    ethernets:
      modern-interfaces:
        match:
          name: "en*"
        dhcp4: true
      legacy-interfaces:
        match:
          name: "eth*"
        dhcp4: true

  apt:
    mirror-selection:
      primary:
        - uri: "http://hu.archive.ubuntu.com/ubuntu"
    sources:
      xtradeb.list:
        sources: "deb https://ppa.launchpadcontent.net/xtradeb/apps/ubuntu jammy main"
        keyid: 5301 FA4F D932 44FB C6F6 1499 82BB 6851 C64F 6880

  updates: all

  codecs:
    install: true

  late-commands:
    - curtin in-target -- systemctl set-default multi-user.target
    - curtin in-target -- systemctl disable NetworkManager.service
    - curtin in-target -- systemctl disable NetworkManager-wait-online.service
    - | # Apply Caps Lock - Esc key swap.
      root_path=/target
      mkdir -p "$root_path/etc/default"
      if ! grep -q "XKBOPTIONS=" "$root_path/etc/default/keyboard"; then
        echo 'set number
      $ append

      XKBOPTIONS="caps:swapescape"
      .
      xit' | ex "$root_path/etc/default/keyboard"

      elif ! grep -q "caps:swapescape" "$root_path/etc/default/keyboard"; then
        echo 'set number
      /XKBOPTIONS=/
      . s/"\\(.*\\)"/"\\1,caps:swapescape"/g
      xit' | ex "$root_path/etc/default/keyboard"

      fi

  user-data:
    growpart:
      mode: auto
      devices: ["/"]
    resize_rootfs: True

    write_files:
      - path: /etc/skel/.profile
        permissions: "0777"
        content: |
          # .profile

          if [ -d $HOME/.profile.d ]; then
            for f in $HOME/.profile.d/*.sh; do
              [ -r $f ] && . $f
            done
            unset f
          fi

      - path: /etc/skel/.profile.d/80-set-display.sh
        permissions: "0777"
        content: |
          export DISPLAY=:0

      - path: /etc/skel/.profile.d/99-start-vpn-session.sh
        permissions: "0777"
        content: |
          if [ "/dev/tty1" = "$(tty)" ]; then
            . $HOME/start-vpn-session.sh
          fi

      - path: /etc/skel/.xsession
        permissions: "0777"
        content: |
          exec dbus-run-session -- startlxde

      - path: /etc/skel/vpn-launch.sh
        permissions: "0777"
        content: |
          #!/bin/sh
          echo "Wating for Xorg session."
          until xset -q > /dev/null 2>&1; do
            sleep 1
          done
          dbus-run-session -- /opt/cisco/anyconnect/bin/vpnui &

      - path: /etc/skel/chroot-main-utils.sh
        permissions: "0777"
        content: |
          #!/bin/sh
          root_mount_point="/mnt/main-root"
          lockfile="/run/lock/main_system_chroot_counter.lock"

          mount_chroot_main()(
            dev_mount_points='/dev /dev/pts /dev/shm /dev/dri /dev/snd'
            mount_points="$dev_mount_points /proc /sys /run /tmp /etc/resolv.conf"
            for mount_point in $mount_points; do
              if [ -z "$(findmnt "$root_mount_point$mount_point")" ]; then
                sudo mount --bind "$mount_point" "$root_mount_point$mount_point"
              fi
            done
            if [ -z "$(findmnt  "$root_mount_point/mnt/cisco-vpn-ubuntu")" ]; then
              sudo mkdir -p  "$root_mount_point/mnt/cisco-vpn-ubuntu"
              sudo mount --bind "/" "$root_mount_point/mnt/cisco-vpn-ubuntu"
            fi
            sudo chmod -R 666 /dev/pts/*
            sudo chmod -R 666 /dev/shm/*
            sudo chmod -R 666 /dev/dri/*
            sudo chmod -R 666 /dev/snd/*

            if [ ! -f "$lockfile" ]; then
              counter=1
            else
              counter=$(cat $lockfile)
              counter=$((counter + 1))
            fi
            echo "$counter" > $lockfile
          )

          umount_chroot_main()(
            if [ ! -f "$lockfile" ]; then
              counter=0
            else
              counter=$(cat $lockfile)
              if [ 0 -lt "$counter" ]; then
                counter=$((counter - 1))
              else
                counter=0
              fi
            fi
            echo "$counter" > $lockfile

            if [ 0 -lt "$counter" ]; then
              return 0
            fi

            dev_mount_points='/dev/pts /dev/shm /dev/dri /dev/snd /dev'
            mount_points="$dev_mount_points /proc /sys /run /tmp /etc/resolv.conf"
            for mount_point in $mount_points; do
              sudo umount "$root_mount_point$mount_point"
            done
            sudo umount "$root_mount_point/mnt/cisco-vpn-ubuntu"
          )

      - path: /etc/skel/enter-main-chroot.sh
        permissions: "0777"
        content: |
          #!/bin/sh
          . $HOME/chroot-main-utils.sh

          mount_chroot_main

          sudo chroot "$root_mount_point" su

          umount_chroot_main

      - path: /etc/skel/enter-main-gui.sh
        permissions: "0777"
        content: |
          #!/bin/sh
          . $HOME/chroot-main-utils.sh

          mount_chroot_main

          # Here I give my own desktop environment's xinitrc.
          echo '
          xhost +local: &
          slstatus &
          exec dwm' > /tmp/vpn_xinitrc
          sudo chroot "$root_mount_point" su -c "XINITRC=/tmp/vpn_xinitrc startx"

          umount_chroot_main

      - path: /etc/skel/start-vpn-session.sh
        permissions: "0777"
        content: |
          #!/bin/sh
          $HOME/enter-main-gui.sh &
          . $HOME/vpn-launch.sh

      - path: /etc/skel/enter-main-nspawn.sh
        permissions: "0777"
        content: |
          #!/bin/sh

          bind_args=""
          for path in /dev/tty*; do
            bind_args="$bind_args --bind=$path"
          done
          for path in /dev/input/*; do
            bind_args="$bind_args --bind=$path"
          done
          for path in /dev/dri/*; do
            bind_args="$bind_args --bind=$path"
          done
          for path in /dev/snd/*; do
            bind_args="$bind_args --bind=$path"
          done
          bind_args="$bind_args --bind=/run/udev/data"

          sudo systemd-nspawn -D /mnt/main-root $bind_args \
            -M main-system \

    runcmd:
      - [mkdir, -p, /home/vpnuser]
      - cp -r /etc/skel/** /home/vpnuser/
      - /opt/*vpn*.sh

    packages:
      - wpasupplicant
      - rfkill
      - iputils-ping
      # Desktop
      - alsa-utils
      - xorg
      - xinit
      - stterm
      - neovim
      - less
      - physlock
      # Stuff needed for the Cisco VPN client.
      - lxde-core # For vpn client installation.
      - libwebkit2gtk-4.0-37 # For web SSO authentication.
      - clamav
      - ufw

  packages:
    - wpasupplicant
    - rfkill
    - iputils-ping
    # Desktop
    - alsa-utils
    - xorg
    - xinit
    - stterm
    - neovim
    - less
    - physlock
    # Stuff needed for the Cisco VPN client.
    - lxde-core # For vpn client installation.
    - libwebkit2gtk-4.0-37 # For web SSO authentication.
    - clamav
    - ufw
